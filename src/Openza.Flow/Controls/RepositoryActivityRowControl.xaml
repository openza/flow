<UserControl
    x:Class="Openza.Flow.Controls.RepositoryActivityRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="14,11"
        Background="Transparent"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1"
        DoubleTapped="OnRowDoubleTapped">
        <Grid>
            <Grid
                ColumnSpacing="16"
                Visibility="{Binding ReleaseVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" MinWidth="160" />
                    <ColumnDefinition Width="1.8*" MinWidth="130" />
                    <ColumnDefinition Width="1.1*" MinWidth="90" />
                    <ColumnDefinition Width="1*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" MinWidth="98" />
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Repository}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="13" Text="{Binding Tag}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Author}" TextTrimming="CharacterEllipsis" />
                <Border
                    Grid.Column="4"
                    Padding="8,3"
                    HorizontalAlignment="Left"
                    Background="{Binding BadgeBackground}"
                    BorderBrush="{Binding BadgeBorder}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding BadgeForeground}"
                        Text="{Binding Type}" />
                </Border>
                <TextBlock Grid.Column="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding TimestampText}" />
                <Button
                    Grid.Column="6"
                    MinWidth="74"
                    MinHeight="30"
                    AutomationProperties.Name="{Binding ViewActionText}"
                    Click="OnOpenClicked"
                    Content="View"
                    ToolTipService.ToolTip="View on GitHub" />
            </Grid>

            <Grid
                ColumnSpacing="16"
                Visibility="{Binding WorkflowRunVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" MinWidth="170" />
                    <ColumnDefinition Width="1.6*" MinWidth="130" />
                    <ColumnDefinition Width="1.5*" MinWidth="130" />
                    <ColumnDefinition Width="Auto" MinWidth="100" />
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Workflow}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Repository}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding Trigger}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Branch}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border
                    Grid.Column="3"
                    Padding="8,3"
                    HorizontalAlignment="Left"
                    Background="{Binding BadgeBackground}"
                    BorderBrush="{Binding BadgeBorder}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}" Text="{Binding Conclusion}" />
                </Border>
                <TextBlock Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Status}" />
                <TextBlock Grid.Column="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding TimestampText}" />
                <Button
                    Grid.Column="6"
                    MinWidth="74"
                    MinHeight="30"
                    AutomationProperties.Name="{Binding ViewActionText}"
                    Click="OnOpenClicked"
                    Content="View"
                    ToolTipService.ToolTip="View on GitHub" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
