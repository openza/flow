<UserControl
    x:Class="Openza.Flow.Controls.RepositoryActivityRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1"
        CornerRadius="4"
        DoubleTapped="OnRowDoubleTapped">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="5">
                <TextBlock
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding Repository}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Opacity="0.76"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding PrimaryDetail}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding SecondaryDetail}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border
                        Padding="8,3"
                        Background="{Binding BadgeBackground}"
                        BorderBrush="{Binding BadgeBorder}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{Binding BadgeForeground}"
                            Text="{Binding Badge}" />
                    </Border>
                    <Border
                        Padding="8,3"
                        Background="{Binding SecondaryBadgeBackground}"
                        BorderBrush="{Binding SecondaryBadgeBorder}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Visibility="{Binding SecondaryBadgeVisibility}">
                        <TextBlock
                            FontSize="12"
                            Foreground="{Binding SecondaryBadgeForeground}"
                            Text="{Binding SecondaryBadge}" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding TimestampText}" />
                </StackPanel>
            </StackPanel>

            <Button
                Grid.Column="1"
                Width="32"
                Height="28"
                Padding="0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Open in browser"
                Click="OnOpenClicked"
                ToolTipService.ToolTip="Open in browser">
                <SymbolIcon Symbol="OpenFile" />
            </Button>
        </Grid>
    </Border>
</UserControl>
