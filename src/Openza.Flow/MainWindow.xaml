<Window
    x:Class="Openza.Flow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Openza.Flow.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Openza Flow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <Image
                Width="20"
                Height="20"
                Margin="16,0,10,0"
                VerticalAlignment="Center"
                Source="Assets/Square44x44Logo.targetsize-32_altform-unplated.png" />
            <TextBlock
                x:Name="TitleTextBlock"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                Text="Openza Flow"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid
                x:Name="AuthView"
                MaxWidth="540"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <Image
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Source="Assets/Square150x150Logo.png" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="Openza Flow" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="Native GitHub pull request review inbox for Windows."
                        TextAlignment="Center" />

                    <InfoBar
                        x:Name="AuthInfoBar"
                        IsOpen="False"
                        Severity="Informational" />

                    <Button
                        HorizontalAlignment="Stretch"
                        Click="OnGitHubOAuthClicked"
                        Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A7;" />
                            <TextBlock Text="Sign in with GitHub" />
                        </StackPanel>
                    </Button>

                    <Border
                        x:Name="DeviceCodePanel"
                        Padding="14"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Enter this code on GitHub" />
                            <TextBox
                                x:Name="DeviceCodeBox"
                                FontFamily="Consolas"
                                FontSize="24"
                                FontWeight="SemiBold"
                                IsReadOnly="True"
                                TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnCopyDeviceCodeClicked" Content="Copy code" />
                                <Button Click="OnOpenDevicePageClicked" Content="Open GitHub" />
                                <Button Click="OnCancelDeviceFlowClicked" Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="14"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Personal access token" />
                            <PasswordBox
                                x:Name="PatBox"
                                PasswordRevealMode="Peek"
                                PlaceholderText="Paste a GitHub personal access token" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Use a token with repo or public_repo plus read:user scope."
                                TextWrapping="WrapWholeWords" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Click="OnCreateTokenClicked"
                                    Content="Create token" />
                                <Button
                                    Click="OnPatSignInClicked"
                                    Content="Connect" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <NavigationView
                x:Name="DashboardView"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="True"
                IsPaneOpen="True"
                CompactPaneLength="56"
                OpenPaneLength="220"
                PaneDisplayMode="LeftCompact"
                SelectionChanged="OnNavigationSelectionChanged"
                Visibility="Collapsed">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        x:Name="ReviewRequestsNavItem"
                        Content="Review Requests"
                        Icon="Flag"
                        Tag="review"
                        ToolTipService.ToolTip="Review requests" />
                    <NavigationViewItem
                        x:Name="CreatedNavItem"
                        Content="Created"
                        Icon="Edit"
                        Tag="created"
                        ToolTipService.ToolTip="Created pull requests" />
                </NavigationView.MenuItems>
                <NavigationView.PaneFooter>
                    <NavigationViewItem
                        AutomationProperties.Name="Refresh pull requests"
                        Content="Refresh"
                        Icon="Refresh"
                        Tapped="OnRefreshTapped"
                        ToolTipService.ToolTip="Refresh pull requests">
                    </NavigationViewItem>
                </NavigationView.PaneFooter>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid Padding="18,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <AutoSuggestBox
                                x:Name="SearchBox"
                                Width="420"
                                Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Search pull requests"
                                PlaceholderText="Search pull requests"
                                TextChanged="OnSearchTextChanged" />

                            <ComboBox
                                x:Name="OrganizationCombo"
                                Grid.Column="1"
                                Width="250"
                                Height="40"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Organization filter"
                                SelectionChanged="OnOrganizationChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image
                                                Width="18"
                                                Height="18"
                                                Source="{Binding AvatarUrl}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button
                                x:Name="UserMenuButton"
                                Grid.Column="2"
                                Height="40"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Account menu"
                                Content="User">
                                <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="OnSignOutClicked"
                                                Text="Sign out" />
                                        </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid
                        x:Name="MainContent"
                        Grid.Row="1"
                        Padding="22,20,22,18">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="WideLayout">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="1120" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryColumn.Width" Value="2*" />
                                        <Setter Target="SidebarSpacerColumn.Width" Value="20" />
                                        <Setter Target="SidebarColumn.Width" Value="1*" />
                                        <Setter Target="SidebarPanel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="NarrowLayout">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryColumn.Width" Value="*" />
                                        <Setter Target="SidebarSpacerColumn.Width" Value="0" />
                                        <Setter Target="SidebarColumn.Width" Value="0" />
                                        <Setter Target="SidebarPanel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PrimaryColumn" Width="2*" />
                            <ColumnDefinition x:Name="SidebarSpacerColumn" Width="20" />
                            <ColumnDefinition x:Name="SidebarColumn" Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        x:Name="PageTitle"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="Review Requests" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Pull requests from GitHub, refreshed automatically every few minutes." />
                                </StackPanel>
                                <ProgressRing
                                    x:Name="LoadingRing"
                                    Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    IsActive="False" />
                            </Grid>

                            <ListView
                                x:Name="PullRequestList"
                                Grid.Row="1"
                                Margin="0,12,0,12"
                                Loaded="OnPullRequestListLoaded"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <controls:PullRequestRowControl
                                            CopyNumberRequested="OnPrNumberCopyRequested"
                                            OpenRequested="OnPrOpenRequested" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                x:Name="PrimaryEmptyState"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                                <SymbolIcon
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Symbol="Accept" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="All caught up" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No pull requests in this view." />
                            </StackPanel>

                            <StackPanel
                                x:Name="PrimaryErrorState"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed">
                                <SymbolIcon
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Symbol="Important" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="Something went wrong" />
                                <TextBlock
                                    x:Name="PrimaryErrorMessage"
                                    MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    Click="OnRefreshClicked"
                                    Content="Try again" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="LoadMoreButton"
                                    Click="OnLoadMoreClicked"
                                    Content="Load more" />
                                <TextBlock
                                    x:Name="StatusText"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Ready" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SidebarPanel" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Pivot>
                                <PivotItem Header="Recently reviewed">
                                    <ListView
                                        x:Name="ReviewedList"
                                        SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Margin" Value="0,0,0,12" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <controls:PullRequestRowControl
                                                    IsCompact="True"
                                                    ShowSummary="False"
                                                    CopyNumberRequested="OnPrNumberCopyRequested"
                                                    OpenRequested="OnPrOpenRequested" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </PivotItem>
                                <PivotItem Header="Recently created">
                                    <ListView
                                        x:Name="RecentlyCreatedList"
                                        SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Margin" Value="0,0,0,12" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <controls:PullRequestRowControl
                                                    IsCompact="True"
                                                    ShowAuthor="False"
                                                    ShowSummary="False"
                                                    CopyNumberRequested="OnPrNumberCopyRequested"
                                                    OpenRequested="OnPrOpenRequested" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </PivotItem>
                            </Pivot>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="SettingsContent"
                        Grid.Row="1"
                        Padding="36,28"
                        Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="820" Spacing="14">
                                <StackPanel Margin="0,0,0,10" Spacing="4">
                                    <TextBlock
                                        Style="{ThemeResource TitleTextBlockStyle}"
                                        Text="Settings" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Tune how Openza Flow looks, notifies you, and stays available in Windows." />
                                </StackPanel>

                                <InfoBar
                                    x:Name="SettingsInfoBar"
                                    IsOpen="False"
                                    Severity="Informational" />

                                <TextBlock
                                    Margin="0,12,0,2"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="Account" />

                                <Border
                                    Padding="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Width="24"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE77B;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                x:Name="AccountNameText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="GitHub account" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Connected account used for review requests and created pull requests." />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Sign out of GitHub"
                                            Click="OnSignOutClicked"
                                            Content="Sign out" />
                                    </Grid>
                                </Border>

                                <TextBlock
                                    Margin="0,12,0,2"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="Appearance" />

                                <Border
                                    Padding="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Width="24"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE790;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="Theme" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Choose light, dark, or follow your Windows setting." />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="ThemeCombo"
                                            Grid.Column="2"
                                            Width="180"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Theme"
                                            SelectionChanged="OnThemeChanged">
                                            <ComboBoxItem Content="System" Tag="system" />
                                            <ComboBoxItem Content="Light" Tag="light" />
                                            <ComboBoxItem Content="Dark" Tag="dark" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <TextBlock
                                    Margin="0,14,0,2"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="Notifications and background" />

                                <Border
                                    Padding="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Width="24"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xEA8F;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="Notifications" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Show Windows notifications when new review requests appear." />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                AutomationProperties.Name="Send test notification"
                                                Click="OnTestNotificationClicked"
                                                ToolTipService.ToolTip="Send test notification">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <SymbolIcon Symbol="Comment" />
                                                    <TextBlock Text="Test" />
                                                </StackPanel>
                                            </Button>
                                            <ToggleSwitch
                                                x:Name="NotificationsToggle"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Notifications"
                                                Toggled="OnNotificationsToggled" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border
                                    Padding="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Width="24"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE823;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="Run in background" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Keep Flow in the tray when the window is closed." />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="RunInBackgroundToggle"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Run in background"
                                            OffContent="Off"
                                            OnContent="On"
                                            Toggled="OnRunInBackgroundToggled" />
                                    </Grid>
                                </Border>

                                <Border
                                    Padding="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Width="24"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE7C3;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="Start with Windows" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Launch Flow automatically after signing in to Windows." />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="StartWithWindowsToggle"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Start with Windows"
                                            Toggled="OnStartWithWindowsToggled" />
                                    </Grid>
                                </Border>

                                <TextBlock
                                    Margin="0,14,0,2"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="About" />

                                <Border
                                    Padding="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Width="24"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE946;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="Openza Flow" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="A WinUI 3 GitHub pull request inbox built with Windows App SDK controls and Fluent patterns." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
