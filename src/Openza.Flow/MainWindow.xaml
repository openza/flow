<Window
    x:Class="Openza.Flow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Openza Flow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <Image
                Width="20"
                Height="20"
                Margin="16,0,10,0"
                VerticalAlignment="Center"
                Source="Assets/Square44x44Logo.targetsize-32_altform-unplated.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                Text="Openza Flow"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            CompactPaneLength="52"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavigationItem"
                    Content="Home"
                    Icon="Home"
                    Tag="home"
                    ToolTipService.ToolTip="Developer dashboard" />
                <NavigationViewItem
                    x:Name="SessionsNavigationItem"
                    Content="Agent Sessions"
                    Tag="sessions"
                    ToolTipService.ToolTip="Browse and resume agent sessions">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{StaticResource AgentSessionsGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="GitHubNavigationItem"
                    Content="GitHub"
                    IsExpanded="True"
                    SelectsOnInvoked="False"
                    ToolTipService.ToolTip="GitHub activity">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{StaticResource GitHubGlyph}" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            x:Name="PullRequestsNavigationItem"
                            Content="Pull Requests"
                            Tag="pull-requests"
                            ToolTipService.ToolTip="Review and track pull requests">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{StaticResource PullRequestGlyph}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="ReleasesNavigationItem"
                            Content="Releases"
                            Tag="releases"
                            ToolTipService.ToolTip="Browse repository releases">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{StaticResource ReleaseGlyph}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="WorkflowRunsNavigationItem"
                            Content="Workflow Runs"
                            Tag="workflow-runs"
                            ToolTipService.ToolTip="Inspect GitHub Actions workflow runs">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{StaticResource WorkflowRunGlyph}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="GitHubContextBar"
                    Padding="20,8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="GitHubConnectButton"
                            AutomationProperties.Name="Connect GitHub"
                            Click="OnGitHubConnectClicked"
                            Content="Connect GitHub"
                            Visibility="Collapsed" />
                        <ComboBox
                            x:Name="ShellOrganizationCombo"
                            MinWidth="220"
                            AutomationProperties.Name="GitHub organization"
                            DisplayMemberPath="DisplayName"
                            SelectionChanged="OnShellOrganizationChanged" />
                        <Button
                            x:Name="ShellGitHubAccountButton"
                            MinWidth="104"
                            AutomationProperties.Name="GitHub account"
                            Content="GitHub">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnShellSignOutClicked" Text="Sign out of GitHub" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>
                <ContentControl
                    x:Name="PageHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <ProgressBar
                    x:Name="NavigationProgress"
                    Grid.Row="1"
                    Height="3"
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
