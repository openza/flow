<Page
    x:Class="Openza.Flow.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Openza.Flow.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="DashboardSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="DashboardRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid
            x:Name="PageRoot"
            MaxWidth="1500"
            Padding="28,22,28,32"
            HorizontalAlignment="Stretch"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideDashboard">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1080" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContinueSection.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="AttentionSection.(Grid.Row)" Value="0" />
                            <Setter Target="AttentionSection.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="MediumDashboard">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContinueSection.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="AttentionSection.(Grid.Row)" Value="1" />
                            <Setter Target="AttentionSection.(Grid.Column)" Value="0" />
                            <Setter Target="AttentionSection.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CompactDashboard">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContinueSection.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="AttentionSection.(Grid.Row)" Value="1" />
                            <Setter Target="AttentionSection.(Grid.Column)" Value="0" />
                            <Setter Target="AttentionSection.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="{Binding Greeting}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Pick up recent agent work across your local environments." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    Padding="8"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh dashboard"
                    Click="OnRefreshClicked"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="18" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <AutoSuggestBox
                x:Name="GlobalSearch"
                Grid.Row="1"
                MinHeight="38"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Search agent sessions and folders"
                PlaceholderText="Search agent sessions and folders"
                QueryIcon="Find"
                SuggestionChosen="OnSearchSuggestionChosen"
                QuerySubmitted="OnSearchQuerySubmitted"
                TextChanged="OnSearchTextChanged">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnSearchAcceleratorInvoked" />
                </AutoSuggestBox.KeyboardAccelerators>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="local:HomeSearchResult">
                        <StackPanel Padding="4" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <StackPanel Grid.Row="2" Spacing="8">
                <InfoBar
                    x:Name="ProviderInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="{Binding SessionStatus}"
                    Severity="Warning" />
                <InfoBar
                    x:Name="ActionInfoBar"
                    IsOpen="False" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ItemsControl ItemsSource="{Binding EnvironmentStatuses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:EnvironmentStatusItem">
                                <Border
                                    MinHeight="36"
                                    Padding="12,6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Status}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        MinHeight="36"
                        Padding="12,6"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="GitHub" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding GitHubStatus}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="3" ColumnSpacing="14" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ContinueSection" Style="{StaticResource DashboardSectionStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Recent agent sessions" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnViewSessionsClicked"
                                Content="View all"
                                Padding="4" />
                        </Grid>
                        <StackPanel x:Name="SessionSkeleton" Spacing="8">
                            <Border Height="60" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Opacity="0.65" />
                            <Border Height="60" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Opacity="0.45" />
                            <Border Height="60" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Opacity="0.3" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ContinueWorking}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DashboardSessionItem">
                                    <Border Style="{StaticResource DashboardRowStyle}">
                                        <Grid MinHeight="78" Padding="4,10" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind Folder}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="190" Text="{x:Bind Branch}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="•" />
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Source}" />
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="•" />
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Environment}" />
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="•" />
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Recency}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                MinWidth="80"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Resume session"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                Click="OnResumeSessionClicked"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Tag="{x:Bind Summary}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="12" Glyph="&#xE768;" />
                                                    <TextBlock Text="Resume" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="NoSessionsState" Padding="4,16" Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="No agent sessions found" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding SessionStatus}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AttentionSection" Grid.Column="1" Style="{StaticResource DashboardSectionStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Needs attention" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnViewActivityClicked"
                                Content="View pull requests"
                                Padding="4" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding NeedsAttention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:HomeAttentionItem">
                                    <Border Style="{StaticResource DashboardRowStyle}">
                                        <Grid MinHeight="78" Padding="4,10" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                Glyph="{StaticResource PullRequestGlyph}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock MaxLines="1" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Recency}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="View item on GitHub"
                                                Click="OnOpenAttentionClicked"
                                                Content="View"
                                                Tag="{x:Bind Url}"
                                                ToolTipService.ToolTip="View on GitHub" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="NoAttentionState" Padding="4,16" Spacing="5">
                            <TextBlock x:Name="NoAttentionTitle" FontWeight="SemiBold" Text="Nothing needs attention" />
                            <TextBlock
                                x:Name="NoAttentionMessage"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Pull requests awaiting review and already-loaded failed workflow runs will appear here."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="ConnectGitHubButton"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Click="OnViewActivityClicked"
                                Content="Connect GitHub" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>
